# Copia este archivo como .env y cambia todos los valores. El archivo .env nunca se sube a GitHub.

# Clave para firmar las sesiones. Genera una con:  npx auth secret
# En producción es obligatoria y debe tener al menos 32 caracteres.
AUTH_SECRET="genera-una-clave-aleatoria-de-32-caracteres-o-mas"

# Primera cuenta de administración. Solo se usa si todavía no existe data/admin-auth.json.
# En producción son obligatorias; la contraseña debe tener al menos 12 caracteres.
ADMIN_EMAIL="tu-correo@ejemplo.com"
ADMIN_PASSWORD="elige-una-contraseña-larga"

# Dirección pública del sitio (se usa en enlaces para compartir y en la app Android).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Base de datos PostgreSQL.
# En Neon: DATABASE_URL es la dirección "pooled" (con -pooler) y DIRECT_URL la directa.
# En local puede ser la misma dirección en las dos.
DATABASE_URL="postgresql://usuario:contraseña@localhost:5432/periodico_bilwi"
DIRECT_URL="postgresql://usuario:contraseña@localhost:5432/periodico_bilwi"

# Fotos que sube la redacción.
# "local" guarda en public/uploads (tu computadora o un VPS propio).
# "s3" usa un almacenamiento compatible con S3: Contabo Object Storage, Cloudflare R2…
# En Vercel tiene que ser "s3": su disco se borra en cada despliegue.
STORAGE_DRIVER="local"

# Solo con STORAGE_DRIVER="s3". En Contabo: panel → Object Storage → Credenciales.
S3_ENDPOINT="https://usc1.contabostorage.com"
S3_REGION="us-east-1"
S3_BUCKET="bilwi-fotos"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Opcional: dirección pública del bucket (sin / al final). Con ella las fotos se piden directo
# al almacenamiento. Sin ella, el sitio las lee del bucket por su cuenta (sirve con bucket privado).
# Ejemplos: https://usc1.contabostorage.com/<id>:bilwi-fotos  o  https://fotos.bilwinoticias.com
MEDIA_PUBLIC_URL=""
